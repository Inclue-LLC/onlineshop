# ===== このファイルを .env にコピーして値を入れてください（.env は Git にコミットされません） =====

# 対象ストアのキー（カンマ区切り）。先頭が npm run dev などの既定ストアになります。
STORES=hanul,funyu,mongmong

# Admin API のバージョン（省略時 2026-10）
# SHOPIFY_API_VERSION=2026-10

# ---- スタジオハヌル ----
HANUL_STORE=studio-hanul.myshopify.com
# メタオブジェクト作成用（どちらか一方）
#  A) 管理画面で作成したカスタムアプリのアクセストークン（shpat_...）
HANUL_ADMIN_TOKEN=
#  B) Dev Dashboard で作成しストアにインストールしたアプリのクライアントID／シークレット
HANUL_CLIENT_ID=
HANUL_CLIENT_SECRET=
# テーマ反映用（任意）: Theme Access アプリのパスワード（shptka_...）。空なら CLI のブラウザログインを使う
HANUL_THEME_PASSWORD=
# npm run push で更新するテーマID（任意。空なら CLI が対話で選択）
HANUL_THEME_ID=

# ---- ふにゅ ----
FUNYU_STORE=
FUNYU_ADMIN_TOKEN=
FUNYU_CLIENT_ID=
FUNYU_CLIENT_SECRET=
FUNYU_THEME_PASSWORD=
FUNYU_THEME_ID=

# ---- Lovely MongMong ----
MONGMONG_STORE=
MONGMONG_ADMIN_TOKEN=
MONGMONG_CLIENT_ID=
MONGMONG_CLIENT_SECRET=
MONGMONG_THEME_PASSWORD=
MONGMONG_THEME_ID=
