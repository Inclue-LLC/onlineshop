      {
        "type": "image_picker",
        "id": "logo",
        "label": "t:settings_schema.logo.settings.logo_image.label"
      },
      {
        "type": "range",
        "id": "logo_width",
        "min": 50,
        "max": 300,
        "step": 10,
        "default": 100,
        "unit": "px",
        "label": "t:settings_schema.logo.settings.logo_width.label"
      },
      {
        "type": "image_picker",
        "id": "favicon",
        "label": "t:settings_schema.logo.settings.favicon.label",
        "info": "t:settings_schema.logo.settings.favicon.info"
      }
    ]
  },
  {
    "name": "ブランド設定",
    "settings": [
      {
        "type": "paragraph",
        "content": "キャラクター（ストア）ごとに変わる項目です。基本の色は「色」→ 配色1（背景・テキスト・ボタン＝アクセント）で設定します。ロゴは「ロゴ」で設定します。"
      },
      {
        "type": "header",
        "content": "フォント"
      },
      {
        "type": "checkbox",
        "id": "brand_font_enable",
        "label": "Google Fonts のブランドフォントを使う",
        "default": true
      },
      {
        "type": "text",
        "id": "brand_font_family",
        "label": "フォント名（Google Fonts）",
        "default": "M PLUS Rounded 1c",
        "info": "例：M PLUS Rounded 1c / Zen Maru Gothic / Kosugi Maru"
      },
      {
        "type": "text",
        "id": "brand_font_weights",
        "label": "読み込む太さ",
        "default": "400;500;700;800",
        "info": "セミコロン区切り"
      },
      {
        "type": "select",
        "id": "brand_heading_weight",
        "label": "見出しの太さ",
        "default": "800",
        "options": [
          {
            "value": "500",
            "label": "Medium"
          },
          {
            "value": "700",
            "label": "Bold"
          },
          {
            "value": "800",
            "label": "ExtraBold"
          }
        ]
      },
      {
        "type": "header",
        "content": "カラー"
      },
      {
        "type": "color",
        "id": "brand_accent_soft",
        "label": "アクセント（淡色・バッジ背景）",
        "default": "#F6EBDD"
      },
      {
        "type": "color",
        "id": "brand_live_color",
        "label": "「開催中」バッジ",
        "default": "#9A6450"
      },
      {
        "type": "color",
        "id": "brand_line_color",
        "label": "区切り線",
        "default": "#ECE1D4"
      },
      {
        "type": "paragraph",
        "content": "パステルカラー（画像未設定時の背景・カードの色として順番に使われます）"
      },
      {
        "type": "color",
        "id": "brand_pastel_1",
        "label": "パステル 1",
        "default": "#F4E1C7"
      },
      {
        "type": "color",
        "id": "brand_pastel_2",
        "label": "パステル 2",
        "default": "#F8E9DC"
      },
      {
        "type": "color",
        "id": "brand_pastel_3",
        "label": "パステル 3",
        "default": "#FBE3DD"
      },
      {
        "type": "color",
        "id": "brand_pastel_4",
        "label": "パステル 4",
        "default": "#EFE3D3"
      },
      {
        "type": "color",
        "id": "brand_pastel_5",
        "label": "パステル 5",
        "default": "#F3ECE4"
      },
      {
        "type": "color",
        "id": "brand_pastel_6",
        "label": "パステル 6",
        "default": "#E9D9C6"
      },
      {
        "type": "header",
        "content": "形"
      },
      {
        "type": "range",
        "id": "brand_radius",
        "label": "カードの角丸",
        "min": 0,
        "max": 40,
        "step": 2,
        "unit": "px",
        "default": 24
      },
      {
        "type": "header",
        "content": "POP UP"
      },
      {
        "type": "text",
        "id": "popup_menu_keyword",
        "label": "POP UP リンクの判定",
        "default": "POP UP",
        "info": "ヘッダー・フッターのメニュー項目で、名前がこの文字と一致するもの、またはURLに「/pages/popup」を含むものは、開催中・開催予定のPOP UPがないときに自動で非表示になります。"
      },
      {
        "type": "checkbox",
        "id": "popup_bar_show_upcoming",
        "label": "開催中がないとき、告知バーに開催予定を表示する",
        "default": true
      },
      {
        "type": "header",
        "content": "お知らせ"
      },
      {
        "type": "text",
        "id": "news_categories",
        "label": "カテゴリとして扱うタグ",
        "default": "POP UP,新商品,コラボ",
        "info": "カンマ区切り。記事のタグのうち、ここに含まれるものがバッジとして表示されます。"
      },
      {
        "type": "select",
        "id": "news_thumb_mode",
        "label": "お知らせのサムネイル（既定の表示方法）",
        "default": "crop",
        "options": [
          {
            "value": "crop",
            "label": "正方形に切り取る"
          },
          {
            "value": "fit",
            "label": "全体を表示（周りを背景色で埋める）"
          }
        ],
        "info": "記事ごとに変える場合は、記事のメタフィールド「サムネイルの表示方法」で選びます。"
      },
      {
        "type": "color",
        "id": "news_thumb_bg",
        "label": "全体を表示するときの既定の背景色",
        "info": "未設定の場合はページの背景色"
      },
      {
        "type": "header",
        "content": "フッター"
      },
      {
        "type": "text",
        "id": "brand_operator",
        "label": "運営者表記",
        "default": "運営：合同会社インクルー"
      },
      {
        "type": "header",
        "content": "レビュー（商品カードの星）"
      },
      {
        "type": "html",
        "id": "review_badge_html",
        "label": "商品カードの星評価のコード",
        "info": "レビューアプリ（Ali Reviews など）の「コレクションページ／商品カード用の星評価」の埋め込みコードを貼り付けます。商品IDの部分は {{ product.id }}・{{product.id}}・[product_id] のどれでも、商品ごとのIDに自動で置き換わります。空欄の場合は、Shopify 標準の評価データ（reviews.rating）があれば星を表示します。"
      }
    ]
  },
