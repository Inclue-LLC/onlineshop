{%- liquid
  assign categories = settings.news_categories | split: ','
  assign current_tag = current_tags | first
-%}
<section class="b-page-heading">
  <div class="b-container">
    {%- if current_tag != blank -%}
      {%- render 'b-breadcrumbs', parent_title: blog.title, parent_url: blog.url, current: current_tag -%}
    {%- else -%}
      {%- render 'b-breadcrumbs', current: blog.title -%}
    {%- endif -%}
    <h1 class="b-page-title">{{ blog.title | escape }}</h1>
    {%- if section.settings.show_filter -%}
      <nav class="b-chips" aria-label="カテゴリ">
        <a href="{{ blog.url }}" class="b-chip{% if current_tag == blank %} is-active{% endif %}">すべて</a>
        {%- for category in categories -%}
          {%- assign category_name = category | strip -%}
          {%- if category_name == blank -%}{%- continue -%}{%- endif -%}
          <a
            href="{{ blog.url }}/tagged/{{ category_name | handle }}"
            class="b-chip{% if current_tag == category_name %} is-active{% endif %}"
          >
            {{- category_name | escape -}}
          </a>
        {%- endfor -%}
      </nav>
    {%- endif -%}
  </div>
</section>

<section class="b-section b-section--top-none">
  <div class="b-container">
    {%- paginate blog.articles by section.settings.per_page -%}
      <div class="b-card b-news-rows{% if section.settings.show_image %} b-news-rows--image{% endif %}">
        {%- for article in blog.articles -%}
          {%- render 'b-news-row', article: article, show_image: section.settings.show_image, index: forloop.index0 -%}
        {%- else -%}
          <p class="b-news-row b-news-row--empty">お知らせはまだありません。</p>
        {%- endfor -%}
      </div>
      {%- if paginate.pages > 1 -%}
        <nav class="b-pagination" aria-label="ページ送り">
          {%- if paginate.previous -%}<a href="{{ paginate.previous.url }}" class="b-btn b-btn--outline b-btn--small">← 前へ</a>{%- endif -%}
          <span class="b-pagination__current">{{ paginate.current_page }} / {{ paginate.pages }}</span>
          {%- if paginate.next -%}<a href="{{ paginate.next.url }}" class="b-btn b-btn--outline b-btn--small">次へ →</a>{%- endif -%}
        </nav>
      {%- endif -%}
    {%- endpaginate -%}
  </div>
</section>

{% schema %}
{
  "name": "お知らせ一覧",
  "tag": "div",
  "settings": [
    { "type": "checkbox", "id": "show_filter", "label": "カテゴリの絞り込みを表示", "default": true, "info": "カテゴリは「テーマ設定 > ブランド設定 > お知らせ」で設定します。" },
    { "type": "checkbox", "id": "show_image", "label": "記事の画像を表示", "default": true, "info": "記事の「画像」（アイキャッチ）を表示します。画像が無い記事は色付きの枠になります。" },
    { "type": "range", "id": "per_page", "label": "1ページの件数", "min": 5, "max": 50, "step": 5, "default": 20 }
  ]
}
{% endschema %}
