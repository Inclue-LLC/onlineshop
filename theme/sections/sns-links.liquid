<section class="b-section b-sns">
  <div class="b-container">
    <div class="b-card b-sns__box">
      <h2 class="b-title b-title--small b-center">{{ section.settings.heading | default: shop.name | escape }}{{ section.settings.heading_suffix | escape }}</h2>
      <ul class="b-sns__list">
        {%- for block in section.blocks -%}
          {%- liquid
            assign sns_style = block.settings.style
            if sns_style == 'dark'
              comment
                「自動」：ボタン名とリンク先から SNS を判別して、その SNS の色にする
              endcomment
              assign sns_key = block.settings.label | append: ' ' | append: block.settings.url | downcase
              assign sns_head = block.settings.label | strip | downcase | slice: 0, 4
              if sns_key contains 'instagram'
                assign sns_style = 'instagram'
              elsif sns_key contains 'tiktok'
                assign sns_style = 'tiktok'
              elsif sns_key contains 'youtube' or sns_key contains 'youtu.be'
                assign sns_style = 'youtube'
              elsif sns_key contains 'line.me' or sns_key contains 'lin.ee' or sns_head == 'line'
                assign sns_style = 'line'
              elsif sns_key contains 'twitter' or sns_key contains 'x.com'
                assign sns_style = 'x'
              else
                assign sns_label = block.settings.label | strip | downcase
                if sns_label == 'x' or sns_label contains 'x（' or sns_label contains 'x ('
                  assign sns_style = 'x'
                endif
              endif
            elsif sns_style == 'solid_dark'
              assign sns_style = 'dark'
            endif
          -%}
          <li {{ block.shopify_attributes }}>
            <a
              href="{{ block.settings.url | default: '#' }}"
              class="b-sns__btn b-sns__btn--{{ sns_style }}"
              target="_blank"
              rel="noopener"
            >
              <span class="b-sns__label">{{ block.settings.label | escape }}</span>
              {%- if block.settings.sublabel != blank -%}<span class="b-sns__sub">{{ block.settings.sublabel | escape }}</span>{%- endif -%}
            </a>
          </li>
        {%- endfor -%}
      </ul>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "各種リンク（SNS）",
  "tag": "div",
  "settings": [
    { "type": "text", "id": "heading", "label": "見出し", "info": "空欄の場合はストア名" },
    { "type": "text", "id": "heading_suffix", "label": "見出しの後ろの文字", "default": "をもっと楽しむ" }
  ],
  "blocks": [
    {
      "type": "link",
      "name": "リンク",
      "settings": [
        { "type": "text", "id": "label", "label": "名前", "default": "X" },
        { "type": "text", "id": "sublabel", "label": "補足（アカウント名など）", "default": "@[アカウント]" },
        { "type": "url", "id": "url", "label": "リンク先" },
        {
          "type": "select",
          "id": "style",
          "label": "ボタンの色",
          "default": "dark",
          "info": "「自動」はボタン名・リンク先から X／Instagram／TikTok／YouTube／LINE を判別して、そのSNSの色にします。",
          "options": [
            { "value": "dark", "label": "自動（各SNSの色・該当なしはダーク）" },
            { "value": "line", "label": "LINE（緑）" },
            { "value": "x", "label": "X（黒）" },
            { "value": "instagram", "label": "Instagram（グラデーション）" },
            { "value": "tiktok", "label": "TikTok（黒）" },
            { "value": "youtube", "label": "YouTube（赤）" },
            { "value": "solid_dark", "label": "ダーク（固定）" },
            { "value": "accent", "label": "アクセントカラー" },
            { "value": "outline", "label": "白（枠線）" }
          ]
        }
      ]
    }
  ],
  "max_blocks": 12,
  "presets": [
    {
      "name": "各種リンク（SNS）",
      "blocks": [
        { "type": "link", "settings": { "label": "LINEスタンプ", "sublabel": "LINE STORE", "style": "line" } },
        { "type": "link", "settings": { "label": "LINE公式アカウント", "sublabel": "最新情報を配信", "style": "line" } },
        { "type": "link", "settings": { "label": "X", "sublabel": "@[アカウント]", "style": "dark" } },
        { "type": "link", "settings": { "label": "Instagram", "sublabel": "@[アカウント]", "style": "dark" } },
        { "type": "link", "settings": { "label": "TikTok", "sublabel": "@[アカウント]", "style": "dark" } },
        { "type": "link", "settings": { "label": "YouTube", "sublabel": "[チャンネル名]", "style": "dark" } }
      ]
    }
  ]
}
{% endschema %}
