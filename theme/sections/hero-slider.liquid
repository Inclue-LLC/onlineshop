{%- liquid
  assign slide_count = section.blocks.size
-%}
<section class="b-hero b-section b-section--tight" style="--hero-ratio: {{ section.settings.ratio_desktop }}; --hero-ratio-mobile: {{ section.settings.ratio_mobile }};">
  <div class="b-container">
    <b-slider
      class="b-slider"
      data-autoplay="{{ section.settings.autoplay }}"
      data-interval="{{ section.settings.interval | times: 1000 }}"
      aria-roledescription="carousel"
      aria-label="{{ section.settings.label | escape }}"
    >
      <ul class="b-slider__track" data-slider-track>
        {%- for block in section.blocks -%}
          <li
            class="b-slider__slide"
            id="Slide-{{ section.id }}-{{ forloop.index }}"
            aria-roledescription="slide"
            aria-label="{{ forloop.index }} / {{ slide_count }}"
            {{ block.shopify_attributes }}
          >
            {%- if block.settings.link != blank -%}<a href="{{ block.settings.link }}" class="b-slider__link">{%- endif -%}
            {%- if block.settings.image != blank -%}
              {%- liquid
                assign alt = block.settings.alt | default: block.settings.image.alt
                if forloop.first
                  assign loading = 'eager'
                  assign priority = 'high'
                else
                  assign loading = 'lazy'
                  assign priority = 'auto'
                endif
              -%}
              <picture>
                {%- if block.settings.image_mobile != blank -%}
                  <source
                    media="(max-width: 749px)"
                    srcset="{{ block.settings.image_mobile | image_url: width: 750 }} 750w, {{ block.settings.image_mobile | image_url: width: 1100 }} 1100w"
                    sizes="100vw"
                  >
                {%- endif -%}
                {{
                  block.settings.image
                  | image_url: width: 2400
                  | image_tag:
                    class: 'b-slider__img',
                    loading: loading,
                    fetchpriority: priority,
                    widths: '750, 1100, 1500, 1800, 2400',
                    sizes: '(min-width: 1240px) 1200px, 100vw',
                    alt: alt
                }}
              </picture>
            {%- else -%}
              {%- render 'b-placeholder',
                label: 'ヘッダー画像',
                note: '推奨 2400×1000px ／ 新商品・POP UPのバナーに差し替え可（スライド）',
                color: 1,
                dashed: true
              -%}
            {%- endif -%}
            {%- if block.settings.link != blank -%}</a>{%- endif -%}
          </li>
        {%- endfor -%}
      </ul>
      {%- if slide_count > 1 -%}
        <div class="b-slider__dots" role="group" aria-label="スライドの切り替え">
          {%- for block in section.blocks -%}
            <button
              type="button"
              class="b-slider__dot{% if forloop.first %} is-active{% endif %}"
              data-slide-to="{{ forloop.index0 }}"
              aria-label="スライド {{ forloop.index }} を表示"
              aria-controls="Slide-{{ section.id }}-{{ forloop.index }}"
            ></button>
          {%- endfor -%}
        </div>
      {%- endif -%}
    </b-slider>
  </div>
</section>

{% schema %}
{
  "name": "ヘッダー画像（スライド）",
  "tag": "div",
  "settings": [
    { "type": "text", "id": "label", "label": "スライドの名前（読み上げ用）", "default": "メインビジュアル" },
    { "type": "checkbox", "id": "autoplay", "label": "自動で切り替える", "default": true },
    { "type": "range", "id": "interval", "label": "切り替え間隔", "min": 3, "max": 10, "step": 1, "unit": "秒", "default": 5 },
    {
      "type": "select",
      "id": "ratio_desktop",
      "label": "PCの縦横比",
      "default": "2.4",
      "options": [
        { "value": "2.4", "label": "2400×1000（12:5）" },
        { "value": "2", "label": "2:1" },
        { "value": "1.7778", "label": "16:9" },
        { "value": "3", "label": "3:1" }
      ]
    },
    {
      "type": "select",
      "id": "ratio_mobile",
      "label": "スマホの縦横比",
      "default": "1.25",
      "options": [
        { "value": "2.4", "label": "PCと同じ（12:5）" },
        { "value": "1.25", "label": "5:4" },
        { "value": "1", "label": "1:1" },
        { "value": "0.8", "label": "4:5" }
      ]
    }
  ],
  "blocks": [
    {
      "type": "slide",
      "name": "スライド",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "画像（PC）", "info": "推奨 2400×1000px" },
        { "type": "image_picker", "id": "image_mobile", "label": "画像（スマホ・任意）", "info": "推奨 1100×880px" },
        { "type": "text", "id": "alt", "label": "代替テキスト" },
        { "type": "url", "id": "link", "label": "リンク先" }
      ]
    }
  ],
  "max_blocks": 8,
  "presets": [
    {
      "name": "ヘッダー画像（スライド）",
      "blocks": [{ "type": "slide" }, { "type": "slide" }, { "type": "slide" }]
    }
  ]
}
{% endschema %}
