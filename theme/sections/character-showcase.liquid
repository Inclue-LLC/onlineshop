{%- assign page_url = section.settings.page_url | default: '/pages/characters' -%}
{%- comment -%}
  並び順：テーマエディタで「キャラクター」ブロックを追加していればその順番（ドラッグで並び替え可）、
  無ければキャラクターの「表示順」の数字の順。
{%- endcomment -%}
{%- capture character_keys -%}{%- render 'character-block-keys', blocks: section.blocks -%}{%- endcapture -%}
{%- if character_keys == blank -%}
  {%- capture character_keys -%}{%- render 'character-sorted-keys' -%}{%- endcapture -%}
{%- endif -%}
{%- liquid
  assign character_keys = character_keys | strip | split: ',' | sort
  assign main_character = nil
  for key in character_keys
    assign key_parts = key | split: '|'
    if key_parts[1] == 'main'
      assign main_character = shop.metaobjects.character[key_parts[2]]
      break
    endif
  endfor
-%}
<section class="b-section b-character-showcase">
  <div class="b-container">
    {%- render 'b-section-head', heading: section.settings.heading, subheading: section.settings.subheading -%}
    {%- if section.settings.layout == 'main_sub' -%}

    <div class="b-card b-split">
      <div class="b-split__media" style="--ph-bg: var(--brand-pastel-1);">
        {%- if main_character.illustration.value != blank -%}
          {{
            main_character.illustration.value
            | image_url: width: 1200
            | image_tag: loading: 'lazy', widths: '500, 800, 1200', sizes: '(min-width: 990px) 600px, 100vw', alt: main_character.name.value
          }}
        {%- else -%}
          <span class="b-ph__label">メインキャラクター イラスト</span>
        {%- endif -%}
      </div>
      <div class="b-split__body">
        <span class="b-badge b-badge--soft">メインキャラクター</span>
        <h3 class="b-split__title">{{ main_character.name.value | default: '[キャラクター名]' | escape }}</h3>
        <p class="b-text-muted">
          {{- main_character.short_description.value | default: main_character.description.value | default: '[キャラクターの簡単な紹介文 1〜2行]' | strip_newlines | truncate: 80 | escape -}}
        </p>
        {%- if page_url != blank -%}
          <a href="{{ page_url }}" class="b-more">プロフィールを見る →</a>
        {%- endif -%}
      </div>
    </div>

    <ul class="b-grid b-grid--4 b-grid--sp-2 b-sub-characters">
      {%- assign sub_count = 0 -%}
      {%- for key in character_keys -%}
        {%- assign key_parts = key | split: '|' -%}
        {%- if key_parts[1] != 'sub' -%}{%- continue -%}{%- endif -%}
        {%- if sub_count >= section.settings.sub_limit -%}{%- break -%}{%- endif -%}
        {%- assign sub_count = sub_count | plus: 1 -%}
        {%- assign character = shop.metaobjects.character[key_parts[2]] -%}
        {%- assign pastel = sub_count | modulo: 6 | plus: 1 -%}
        <li class="b-card b-sub-character">
          <div class="b-sub-character__icon" style="--ph-bg: {% if character.theme_color != blank %}{{ character.theme_color.value }}{% else %}var(--brand-pastel-{{ pastel }}){% endif %};">
            {%- if character.illustration.value != blank -%}
              {{ character.illustration.value | image_url: width: 300 | image_tag: loading: 'lazy', alt: character.name.value }}
            {%- else -%}
              <span class="b-ph__label">イラスト</span>
            {%- endif -%}
          </div>
          <p class="b-sub-character__name">{{ character.name.value | escape }}</p>
          <p class="b-sub-character__text">
            {{- character.short_description.value | default: character.description.value | strip_newlines | truncate: 30 | escape -}}
          </p>
        </li>
      {%- endfor -%}
      {%- if sub_count == 0 -%}
        {%- for i in (1..4) -%}
          <li class="b-card b-sub-character">
            <div class="b-sub-character__icon" style="--ph-bg: var(--brand-pastel-{{ i | plus: 1 }});"><span class="b-ph__label">イラスト</span></div>
            <p class="b-sub-character__name">[サブキャラ名]</p>
            <p class="b-sub-character__text">[ひとこと紹介]</p>
          </li>
        {%- endfor -%}
      {%- endif -%}
    </ul>

    {%- else -%}
      {%- comment -%} すべてのキャラクターを同じ大きさで並べる {%- endcomment -%}
      {%- capture ill_max_h -%}{%- render 'character-illust-max-height', keys: character_keys, limit: section.settings.limit -%}{%- endcapture -%}
      {%- assign ill_max_h = ill_max_h | strip | plus: 0 -%}
      <ul class="b-grid b-grid--3 b-characters">
        {%- assign shown = 0 -%}
        {%- for key in character_keys limit: section.settings.limit -%}
          {%- assign key_parts = key | split: '|' -%}
          {%- assign character = shop.metaobjects.character[key_parts[2]] -%}
          {%- unless character -%}{%- continue -%}{%- endunless -%}
          {%- assign shown = shown | plus: 1 -%}
          {%- assign pastel = forloop.index0 | modulo: 6 | plus: 1 -%}
          <li class="b-card b-chara-card">
            <a href="{{ page_url }}#character-{{ character.system.handle }}" class="b-chara-card__link">
              <div
                class="b-chara-card__media"
                style="--ph-bg: {% if character.theme_color != blank %}{{ character.theme_color.value }}{% else %}var(--brand-pastel-{{ pastel }}){% endif %};"
              >
                {%- if character.illustration.value != blank -%}
                  {%- render 'b-chara-illust',
                    character: character,
                    max_h: ill_max_h,
                    width: 900,
                    sizes: '(min-width: 990px) 400px, 33vw'
                  -%}
                {%- else -%}
                  <span class="b-ph__label">イラスト</span>
                {%- endif -%}
              </div>
              <div class="b-chara-card__body">
                <h3 class="b-chara-card__name">{{ character.name.value | escape }}</h3>
                {%- if character.name_en != blank -%}<p class="b-chara-card__en">{{ character.name_en.value | escape }}</p>{%- endif -%}
                {%- assign intro = character.short_description.value | default: character.description.value -%}
                {%- if intro != blank -%}
                  <p class="b-chara-card__text">{{ intro | strip_newlines | truncate: 60 | escape }}</p>
                {%- endif -%}
              </div>
            </a>
          </li>
        {%- endfor -%}
        {%- if shown == 0 -%}
          {%- for i in (1..3) -%}
            <li class="b-card b-chara-card">
              <div class="b-chara-card__media" style="--ph-bg: var(--brand-pastel-{{ i }});"><span class="b-ph__label">イラスト</span></div>
              <div class="b-chara-card__body">
                <h3 class="b-chara-card__name">[キャラクター名]</h3>
                <p class="b-chara-card__text">[ひとこと紹介]</p>
              </div>
            </li>
          {%- endfor -%}
        {%- endif -%}
      </ul>
    {%- endif -%}

    {%- if section.settings.button_label != blank and page_url != blank -%}
      <div class="b-center">
        <a href="{{ page_url }}" class="b-btn b-btn--outline">{{ section.settings.button_label | escape }}</a>
      </div>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "キャラクター紹介（簡易）",
  "tag": "div",
  "settings": [
    {
      "type": "paragraph",
      "content": "キャラクターはメタオブジェクト「キャラクター」で管理し、表示順に並びます。並び順を変えたいときは、下の「ブロックを追加」から「キャラクター」を追加してキャラクターを選び、ドラッグで並べ替えてください（ブロックが無いときは「表示順」の数字の順）。"
    },
    {
      "type": "select",
      "id": "layout",
      "label": "並べ方",
      "default": "equal",
      "options": [
        {
          "value": "equal",
          "label": "すべて同じ大きさで並べる"
        },
        {
          "value": "main_sub",
          "label": "メイン（大きく）＋サブ"
        }
      ]
    },
    {
      "type": "range",
      "id": "limit",
      "label": "表示する数（同じ大きさで並べるとき）",
      "min": 1,
      "max": 12,
      "step": 1,
      "default": 3
    },
    {
      "type": "text",
      "id": "heading",
      "label": "見出し",
      "default": "キャラクター"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "小見出し",
      "default": "CHARACTERS"
    },
    {
      "type": "range",
      "id": "sub_limit",
      "label": "サブキャラクターの表示数（メイン＋サブのとき）",
      "min": 0,
      "max": 12,
      "step": 1,
      "default": 4
    },
    {
      "type": "url",
      "id": "page_url",
      "label": "キャラクター紹介ページ",
      "info": "未設定の場合は /pages/characters"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "ボタンの文字",
      "default": "キャラクター紹介ページへ"
    }
  ],
  "presets": [
    {
      "name": "キャラクター紹介（簡易）"
    }
  ],
  "blocks": [
    {
      "type": "character",
      "name": "キャラクター",
      "settings": [
        {
          "type": "metaobject",
          "id": "character",
          "label": "キャラクター",
          "metaobject_type": "character"
        }
      ]
    }
  ],
  "max_blocks": 24
}
{% endschema %}
