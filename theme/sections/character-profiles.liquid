{%- capture character_keys -%}{%- render 'character-sorted-keys' -%}{%- endcapture -%}
{%- assign character_keys = character_keys | strip | split: ',' | sort -%}
{%- liquid
  assign profile_all = true
  if section.settings.layout == 'main_sub'
    assign profile_all = false
  endif
-%}
<section class="b-section b-character-profiles">
  <div class="b-container">
    {%- render 'b-section-head', heading: section.settings.heading, subheading: section.settings.subheading -%}
    {%- assign main_count = 0 -%}
    {%- for key in character_keys -%}
      {%- assign key_parts = key | split: '|' -%}
      {%- if profile_all == false and key_parts[1] != 'main' -%}{%- continue -%}{%- endif -%}
      {%- assign character = shop.metaobjects.character[key_parts[2]] -%}
      {%- unless character -%}{%- continue -%}{%- endunless -%}
      {%- assign main_count = main_count | plus: 1 -%}
      {%- assign pastel = main_count | minus: 1 | modulo: 6 | plus: 1 -%}
      {%- assign is_even = main_count | modulo: 2 -%}
      <article
        class="b-card b-split b-split--profile{% if profile_all and is_even == 0 %} b-split--reverse{% endif %}"
        id="character-{{ character.system.handle }}"
      >
        <div class="b-split__media" style="--ph-bg: {% if character.theme_color != blank %}{{ character.theme_color.value }}{% else %}var(--brand-pastel-{{ pastel }}){% endif %};">
          {%- if character.illustration.value != blank -%}
            {{
              character.illustration.value
              | image_url: width: 1400
              | image_tag: loading: 'eager', widths: '500, 800, 1100, 1400', sizes: '(min-width: 990px) 600px, 100vw', alt: character.name.value
            }}
          {%- else -%}
            <span class="b-ph__label">全身イラスト</span>
          {%- endif -%}
        </div>
        <div class="b-split__body">
          {%- unless profile_all -%}<span class="b-badge b-badge--soft">メインキャラクター</span>{%- endunless -%}
          <h2 class="b-split__title b-split__title--large">{{ character.name.value | escape }}</h2>
          {%- if character.name_en != blank -%}<p class="b-split__en">{{ character.name_en.value | escape }}</p>{%- endif -%}
          {%- if character.description != blank -%}
            <p class="b-split__text">{{ character.description.value | escape | newline_to_br }}</p>
          {%- endif -%}
          {%- render 'b-character-dl', character: character -%}
          {%- if character.collection.value != blank -%}
            <a href="{{ character.collection.value.url }}" class="b-btn">{{ section.settings.goods_label | escape }}</a>
          {%- endif -%}
        </div>
      </article>
    {%- endfor -%}
    {%- if main_count == 0 and request.design_mode -%}
      <div class="b-card b-split b-split--profile">
        <div class="b-split__media" style="--ph-bg: var(--brand-pastel-1);"><span class="b-ph__label">全身イラスト</span></div>
        <div class="b-split__body">
          <h2 class="b-split__title b-split__title--large">[キャラクター名]</h2>
          <p class="b-split__text">メタオブジェクト「キャラクター」を登録すると表示されます。</p>
        </div>
      </div>
    {%- endif -%}

    {%- liquid
      assign sub_count = 0
      for key in character_keys
        assign key_parts = key | split: '|'
        if key_parts[1] == 'sub'
          assign sub_count = sub_count | plus: 1
        endif
      endfor
    -%}
    {%- if sub_count > 0 and profile_all == false -%}
      <h2 class="b-title b-title--section">{{ section.settings.sub_heading | escape }}</h2>
      <div class="b-grid b-grid--4 b-grid--sp-2">
        {%- assign index = 0 -%}
        {%- for key in character_keys -%}
          {%- assign key_parts = key | split: '|' -%}
          {%- if key_parts[1] != 'sub' -%}{%- continue -%}{%- endif -%}
          {%- assign index = index | plus: 1 -%}
          {%- assign character = shop.metaobjects.character[key_parts[2]] -%}
          {%- assign pastel = index | modulo: 6 | plus: 1 -%}
          <article class="b-card b-friend" id="character-{{ character.system.handle }}">
            <div class="b-friend__media" style="--ph-bg: {% if character.theme_color != blank %}{{ character.theme_color.value }}{% else %}var(--brand-pastel-{{ pastel }}){% endif %};">
              {%- if character.illustration.value != blank -%}
                {{
                  character.illustration.value
                  | image_url: width: 600
                  | image_tag: loading: 'lazy', widths: '300, 450, 600', sizes: '(min-width: 990px) 280px, 50vw', alt: character.name.value
                }}
              {%- else -%}
                <span class="b-ph__label">イラスト</span>
              {%- endif -%}
            </div>
            <div class="b-friend__body">
              <h3 class="b-friend__name">{{ character.name.value | escape }}</h3>
              {%- if character.description != blank -%}
                <p class="b-friend__text">{{ character.description.value | escape | newline_to_br }}</p>
              {%- endif -%}
              {%- if character.favorite != blank -%}
                <p class="b-friend__meta">すきなもの：{{ character.favorite.value | escape }}</p>
              {%- endif -%}
            </div>
          </article>
        {%- endfor -%}
      </div>
    {%- endif -%}

    {%- if section.settings.relation_image != blank or request.design_mode -%}
      <div class="b-card b-relation">
        <h2 class="b-title b-title--small">{{ section.settings.relation_heading | escape }}</h2>
        {%- if section.settings.relation_image != blank -%}
          {{
            section.settings.relation_image
            | image_url: width: 1800
            | image_tag: loading: 'lazy', widths: '600, 900, 1200, 1800', sizes: '(min-width: 1240px) 1150px, 100vw', class: 'b-relation__img'
          }}
        {%- else -%}
          {%- render 'b-placeholder', label: '相関図イラスト（任意・画像を設定すると表示されます）', color: 1, dashed: true -%}
        {%- endif -%}
      </div>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "キャラクタープロフィール",
  "tag": "div",
  "settings": [
    { "type": "paragraph", "content": "メタオブジェクト「キャラクター」の内容を表示順に表示します。" },
    { "type": "text", "id": "heading", "label": "見出し", "info": "空欄の場合は表示しません" },
    { "type": "text", "id": "subheading", "label": "小見出し" },
    {
      "type": "select",
      "id": "layout",
      "label": "並べ方",
      "default": "equal",
      "options": [
        { "value": "equal", "label": "全員を同じ大きさのプロフィールで並べる" },
        { "value": "main_sub", "label": "メイン（大きなプロフィール）＋サブ（なかまたち）" }
      ]
    },
    { "type": "text", "id": "goods_label", "label": "グッズボタンの文字", "default": "このキャラクターのグッズを見る" },
    { "type": "text", "id": "sub_heading", "label": "サブキャラクターの見出し", "default": "なかまたち" },
    { "type": "text", "id": "relation_heading", "label": "相関図の見出し", "default": "キャラクター相関図" },
    { "type": "image_picker", "id": "relation_image", "label": "相関図の画像（任意）", "info": "未設定の場合、相関図は表示されません。" }
  ],
  "presets": [{ "name": "キャラクタープロフィール" }]
}
{% endschema %}
