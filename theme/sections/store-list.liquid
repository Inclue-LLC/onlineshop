{%- capture store_keys -%}{%- render 'store-sorted-keys' -%}{%- endcapture -%}
{%- liquid
  assign store_keys = store_keys | strip | split: ',' | sort
  assign is_top = false
  if section.settings.mode == 'top'
    assign is_top = true
  endif
  assign areas = '北海道・東北,関東,中部,近畿,中国・四国,九州・沖縄' | split: ','
  assign shown = 0
-%}
<section class="b-section b-store-list">
  <div class="b-container">
    {%- render 'b-section-head',
      heading: section.settings.heading,
      subheading: section.settings.subheading,
      link_label: section.settings.more_label,
      link_url: section.settings.more_url
    -%}

    <b-store-filter class="b-store-filter">
      {%- if section.settings.show_filter and is_top == false -%}
        <div class="b-chips" role="group" aria-label="エリアで絞り込み">
          <button type="button" class="b-chip is-active" data-area-filter="" aria-pressed="true">すべて</button>
          {%- for area in areas -%}
            <button type="button" class="b-chip" data-area-filter="{{ area }}" aria-pressed="false">{{ area }}</button>
          {%- endfor -%}
        </div>
        <p class="b-store-filter__count" aria-live="polite"><span data-store-count></span>件の店舗</p>
      {%- endif -%}

      <div class="b-grid b-grid--3">
        {%- for key in store_keys -%}
          {%- assign key_parts = key | split: '|' -%}
          {%- if is_top and key_parts[1] != 'top' -%}{%- continue -%}{%- endif -%}
          {%- if is_top and shown >= section.settings.limit -%}{%- break -%}{%- endif -%}
          {%- assign shown = shown | plus: 1 -%}
          {%- assign store = shop.metaobjects.retail_store[key_parts[2]] -%}
          {%- render 'b-store-card', store: store, compact: is_top -%}
        {%- endfor -%}
        {%- if shown == 0 -%}
          {%- if request.design_mode -%}
            {%- for i in (1..3) -%}
              {%- render 'b-store-card', store: blank, compact: is_top -%}
            {%- endfor -%}
          {%- else -%}
            <p class="b-empty">{{ section.settings.empty_message | escape }}</p>
          {%- endif -%}
        {%- endif -%}
      </div>
      {%- if section.settings.show_filter and is_top == false -%}
        <p class="b-empty" data-store-empty hidden>このエリアの店舗はありません。</p>
      {%- endif -%}
    </b-store-filter>

    {%- if section.settings.note != blank -%}
      <p class="b-note">{{ section.settings.note | escape }}</p>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "店舗情報",
  "tag": "div",
  "settings": [
    { "type": "paragraph", "content": "店舗はメタオブジェクト「店舗」で管理します。" },
    {
      "type": "select",
      "id": "mode",
      "label": "表示する店舗",
      "default": "all",
      "options": [
        { "value": "top", "label": "「トップに表示」がオンの店舗のみ（簡易表示）" },
        { "value": "all", "label": "すべての店舗（店舗一覧ページ向け）" }
      ]
    },
    { "type": "range", "id": "limit", "label": "最大表示件数（トップ向け）", "min": 1, "max": 12, "step": 1, "default": 3 },
    { "type": "checkbox", "id": "show_filter", "label": "エリアの絞り込みボタンを表示（すべての店舗のとき）", "default": true },
    { "type": "text", "id": "heading", "label": "見出し", "default": "店舗情報" },
    { "type": "text", "id": "subheading", "label": "小見出し" },
    { "type": "text", "id": "more_label", "label": "右上リンクの文字" },
    { "type": "url", "id": "more_url", "label": "右上リンクのリンク先" },
    { "type": "text", "id": "note", "label": "注記", "default": "※ 在庫状況は店舗により異なります。お出かけ前に各店舗へお問い合わせください。" },
    { "type": "text", "id": "empty_message", "label": "店舗が無いときのメッセージ", "default": "取扱店舗は準備中です。" }
  ],
  "presets": [{ "name": "店舗情報" }]
}
{% endschema %}
