{%- comment -%}
  メルマガ登録フォーム。Shopify 標準の顧客登録（form 'customer'）を使い、
  登録されたメールアドレスは管理画面「顧客」に「メール配信を承諾済み」として保存される（タグ: newsletter）。
{%- endcomment -%}
<section class="b-section b-newsletter" id="newsletter-{{ section.id }}">
  <div class="b-container">
    {%- liquid
      assign perk_blocks = section.blocks | where: 'type', 'perk'
      assign has_perks = false
      if perk_blocks.size > 0
        assign has_perks = true
      endif
      assign has_visual = false
      if has_perks == false
        if section.settings.image != blank or request.design_mode
          assign has_visual = true
        endif
      endif
    -%}
    <div class="b-card b-newsletter__box{% if has_visual %} b-newsletter__box--visual{% endif %}{% if has_perks %} b-newsletter__box--perks{% endif %}">
      {%- if section.settings.badge != blank -%}
        <p class="b-newsletter__badge-wrap b-newsletter__badge-wrap--sp"><span class="b-badge b-badge--accent b-newsletter__badge{% if section.settings.heading == blank %} b-newsletter__badge--title{% endif %}">{{ section.settings.badge | escape }}</span></p>
      {%- endif -%}
      {%- if has_visual -%}
        {%- liquid
          assign visual_style = section.settings.image_style | default: 'phone'
        -%}
        <div class="b-newsletter__visual b-newsletter__visual--{{ visual_style }}">
          <div class="b-newsletter__frame">
            <div class="b-newsletter__screen">
              {%- if section.settings.image != blank -%}
                {%- comment -%} 見本なので、表示に必要な大きさ（最大幅600px）で読み込む {%- endcomment -%}
                {{
                  section.settings.image
                  | image_url: width: 600
                  | image_tag: loading: 'lazy', widths: '300, 450, 600', sizes: '(min-width: 750px) 300px, 60vw', class: 'b-newsletter__image', alt: section.settings.sample_label
                }}
              {%- else -%}
                {%- render 'b-placeholder', label: '壁紙の見本画像', note: '縦長（例 1080×1920px）がおすすめ', color: 1 -%}
              {%- endif -%}
              {%- if section.settings.watermark -%}
                <span class="b-newsletter__watermark" aria-hidden="true">SAMPLE</span>
              {%- endif -%}
              {%- if section.settings.sample_label != blank -%}
                <span class="b-newsletter__sample-label">{{ section.settings.sample_label | escape }}</span>
              {%- endif -%}
            </div>
          </div>
        </div>
      {%- endif -%}
      <div class="b-newsletter__content">
      {%- if section.settings.badge != blank -%}
        <p class="b-newsletter__badge-wrap b-newsletter__badge-wrap--pc"><span class="b-badge b-badge--accent b-newsletter__badge{% if section.settings.heading == blank %} b-newsletter__badge--title{% endif %}">{{ section.settings.badge | escape }}</span></p>
      {%- endif -%}
      {%- if section.settings.subheading != blank -%}
        <p class="b-subtitle b-center b-newsletter__sub">{{ section.settings.subheading | escape }}</p>
      {%- endif -%}
      {%- if section.settings.heading != blank -%}
        <h2 class="b-title b-title--small b-center b-newsletter__title">{{ section.settings.heading | escape }}</h2>
      {%- endif -%}
      {%- if section.settings.text != blank -%}
        <div class="b-newsletter__text rte">{{ section.settings.text }}</div>
      {%- endif -%}

      {%- if has_perks -%}
        <ul class="b-newsletter__perks" role="list">
          {%- for block in perk_blocks -%}
            {%- assign perk_style = block.settings.style | default: 'phone' -%}
            <li class="b-newsletter__perk b-newsletter__perk--{{ perk_style }}" {{ block.shopify_attributes }}>
              <div class="b-newsletter__perk-visual">
                {%- if perk_style == 'icon' -%}
                  {%- liquid
                    assign icon_count = 0
                    if block.settings.image != blank
                      assign icon_count = icon_count | plus: 1
                    endif
                    if block.settings.image_2 != blank
                      assign icon_count = icon_count | plus: 1
                    endif
                    if block.settings.image_3 != blank
                      assign icon_count = icon_count | plus: 1
                    endif
                  -%}
                  <div class="b-newsletter__icons b-newsletter__icons--{{ icon_count | at_least: 1 }}">
                    {%- if icon_count == 0 -%}
                      <span class="b-newsletter__icon b-newsletter__icon--ph" aria-hidden="true"></span>
                    {%- endif -%}
                    {%- for img in (1..3) -%}
                      {%- liquid
                        case img
                          when 1
                            assign icon_img = block.settings.image
                          when 2
                            assign icon_img = block.settings.image_2
                          when 3
                            assign icon_img = block.settings.image_3
                        endcase
                      -%}
                      {%- if icon_img != blank -%}
                        <span class="b-newsletter__icon">
                          {{- icon_img | image_url: width: 300 | image_tag: loading: 'lazy', widths: '150, 300', sizes: '120px', alt: block.settings.title -}}
                        </span>
                      {%- endif -%}
                    {%- endfor -%}
                  </div>
                {%- else -%}
                  <div class="b-newsletter__visual b-newsletter__visual--{{ perk_style }}">
                    <div class="b-newsletter__frame">
                      <div class="b-newsletter__screen">
                        {%- if block.settings.image != blank -%}
                          {{
                            block.settings.image
                            | image_url: width: 500
                            | image_tag: loading: 'lazy', widths: '250, 375, 500', sizes: '(min-width: 750px) 200px, 35vw', class: 'b-newsletter__image', alt: block.settings.title
                          }}
                        {%- else -%}
                          {%- render 'b-placeholder', label: '見本画像', color: 1 -%}
                        {%- endif -%}
                        {%- if block.settings.watermark -%}
                          <span class="b-newsletter__watermark" aria-hidden="true">SAMPLE</span>
                        {%- endif -%}
                      </div>
                    </div>
                  </div>
                {%- endif -%}
              </div>
              {%- if block.settings.label != blank -%}
                <p class="b-newsletter__perk-label">{{ block.settings.label | escape }}</p>
              {%- endif -%}
              {%- if block.settings.title != blank -%}
                <h3 class="b-newsletter__perk-title">{{ block.settings.title | escape }}</h3>
              {%- endif -%}
              {%- if block.settings.text != blank -%}
                <p class="b-newsletter__perk-text">{{ block.settings.text | escape }}</p>
              {%- endif -%}
            </li>
          {%- endfor -%}
        </ul>
      {%- endif -%}

      {%- if section.settings.show_next_date -%}
        {%- liquid
          comment
            次回の配信日：今日が配信日より前なら今月、配信日以降なら翌月
          endcomment
          assign d_day = section.settings.delivery_day | default: 1
          assign today_day = 'now' | date: '%d' | plus: 0
          assign n_month = 'now' | date: '%m' | plus: 0
          assign n_year = 'now' | date: '%Y' | plus: 0
          if today_day >= d_day
            assign n_month = n_month | plus: 1
            if n_month > 12
              assign n_month = 1
              assign n_year = n_year | plus: 1
            endif
          endif
          assign n_mm = n_month | prepend: '0' | slice: -2, 2
          assign n_dd = d_day | prepend: '0' | slice: -2, 2
          assign next_str = n_year | append: '-' | append: n_mm | append: '-' | append: n_dd
          assign weekdays = '日,月,火,水,木,金,土' | split: ','
          assign w_index = next_str | date: '%w' | plus: 0
        -%}
        <p class="b-newsletter__next">
          {{ section.settings.next_label | default: '次回の配信は' | escape }}<strong>{{ n_month }}月{{ d_day }}日（{{ weekdays[w_index] }}）</strong>です
        </p>
      {%- endif -%}

      {%- liquid
        comment
          優先する受け取り方法（LINE / メール）を先に、大きく表示する
        endcomment
        assign has_line = false
        if section.settings.line_url != blank
          assign has_line = true
        endif
        assign line_first = false
        if has_line and section.settings.primary != 'email'
          assign line_first = true
        endif
        assign line_only = false
        if has_line and section.settings.primary == 'line_only'
          assign line_only = true
        endif
      -%}

      {%- capture line_block -%}
        {%- if has_line -%}
          <div class="b-newsletter__line-wrap{% if section.settings.qr_image != blank %} b-newsletter__line-wrap--qr{% endif %}">
            <div class="b-newsletter__line-main">
            <a
              href="{{ section.settings.line_url }}"
              class="b-newsletter__line{% unless line_first %} b-newsletter__line--sub{% endunless %}"
              target="_blank"
              rel="noopener"
            >
              {{- section.settings.line_label | escape -}}
            </a>
            {%- if section.settings.line_caption != blank -%}
              <p class="b-newsletter__caption">{{ section.settings.line_caption | escape }}</p>
            {%- endif -%}
            </div>
            {%- if section.settings.qr_image != blank -%}
              <div class="b-newsletter__qr">
                {{ section.settings.qr_image | image_url: width: 240 | image_tag: loading: 'lazy', width: 120, height: 120, alt: 'LINE友だち追加のQRコード' }}
                {%- if section.settings.qr_label != blank -%}
                  <p class="b-newsletter__qr-label">{{ section.settings.qr_label | escape }}</p>
                {%- endif -%}
              </div>
            {%- endif -%}
          </div>
        {%- endif -%}
      {%- endcapture -%}

      {%- capture email_block -%}
      {%- liquid
        assign form_id = 'NewsletterForm-' | append: section.id
        assign return_to = request.path | append: '#newsletter-' | append: section.id
      -%}
      {%- form 'customer', id: form_id, class: 'b-newsletter__form', return_to: return_to -%}
        <input type="hidden" name="contact[tags]" value="{{ section.settings.tag | default: 'newsletter' | escape }}">
        {%- if form.posted_successfully? -%}
          <p class="b-newsletter__message b-newsletter__message--success" role="status">
            {{ section.settings.success_message | escape }}
          </p>
        {%- else -%}
          <div class="b-newsletter__field">
            <label class="visually-hidden" for="NewsletterEmail-{{ section.id }}">メールアドレス</label>
            <input
              id="NewsletterEmail-{{ section.id }}"
              class="b-newsletter__input"
              type="email"
              name="contact[email]"
              value="{{ form.email }}"
              placeholder="{{ section.settings.placeholder | escape }}"
              autocomplete="email"
              autocorrect="off"
              autocapitalize="off"
              required
              {% if form.errors %}
                aria-invalid="true" aria-describedby="NewsletterError-{{ section.id }}"
              {% endif %}
            >
            <button type="submit" class="b-btn b-newsletter__button{% if line_first %} b-btn--outline{% endif %}" name="commit">
              {{- section.settings.button_label | escape -}}
            </button>
          </div>
          {%- if form.errors -%}
            <p class="b-newsletter__message b-newsletter__message--error" id="NewsletterError-{{ section.id }}" role="alert">
              {%- if form.errors.messages.email contains 'taken' or form.errors.messages.email contains '使用' -%}
                このメールアドレスはすでに登録されています。
              {%- else -%}
                メールアドレスを正しく入力してください。
              {%- endif -%}
            </p>
          {%- endif -%}
        {%- endif -%}
      {%- endform -%}
      {%- endcapture -%}

      {%- if line_only -%}
        {{ line_block }}
      {%- elsif line_first -%}
        {{ line_block }}
        <p class="b-newsletter__or"><span>{{ section.settings.or_label | default: 'または' | escape }}</span></p>
        {%- if section.settings.email_lead != blank -%}
          <p class="b-newsletter__caption b-newsletter__caption--lead">{{ section.settings.email_lead | escape }}</p>
        {%- endif -%}
        {{ email_block }}
      {%- else -%}
        {{ email_block }}
        {%- if has_line -%}
          <p class="b-newsletter__or"><span>{{ section.settings.or_label | default: 'または' | escape }}</span></p>
          {{ line_block }}
        {%- endif -%}
      {%- endif -%}

      {%- if section.settings.note != blank -%}
        <div class="b-newsletter__note rte">{{ section.settings.note }}</div>
      {%- endif -%}
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "メルマガ・LINE登録",
  "tag": "div",
  "settings": [
    {
      "type": "paragraph",
      "content": "登録されたメールアドレスは「顧客」にメール配信を承諾済みとして保存されます。Shopify Email などで配信できます。"
    },
    {
      "type": "text",
      "id": "badge",
      "label": "特典のバッジ",
      "default": "毎月1日 限定壁紙プレゼント",
      "info": "空欄にするとバッジを表示しません。"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "見本画像（過去に配信した壁紙など）",
      "info": "縦長（9:16）の画像がおすすめ。表示用に小さめの画質で読み込みます。"
    },
    {
      "type": "select",
      "id": "image_style",
      "label": "見本画像の見せ方",
      "default": "phone",
      "options": [
        {
          "value": "phone",
          "label": "スマホの画面風（枠付き）"
        },
        {
          "value": "plain",
          "label": "角丸の画像のみ"
        }
      ]
    },
    {
      "type": "text",
      "id": "sample_label",
      "label": "画像の上のラベル",
      "default": "過去の配信より",
      "info": "空欄にすると表示しません。"
    },
    {
      "type": "checkbox",
      "id": "watermark",
      "label": "「SAMPLE」の透かしを入れる",
      "default": false
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "小見出し",
      "info": "空欄にすると表示しません。"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "見出し",
      "default": "限定壁紙を毎月1日にお届け"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "説明文",
      "default": "<p>LINE公式アカウント・メールマガジンに登録すると、<strong>毎月1日に限定の壁紙</strong>をお届けします。新商品やPOP UPの情報もいち早くお知らせします。</p>"
    },
    {
      "type": "checkbox",
      "id": "show_next_date",
      "label": "次回の配信日を表示する",
      "default": true
    },
    {
      "type": "text",
      "id": "next_label",
      "label": "次回の配信日の前の文字",
      "default": "次回の配信は",
      "info": "特典が複数あるときは「次回の壁紙の配信は」のように、何の配信日かを書くと分かりやすくなります。"
    },
    {
      "type": "range",
      "id": "delivery_day",
      "label": "毎月の配信日",
      "min": 1,
      "max": 28,
      "step": 1,
      "unit": "日",
      "default": 1
    },
    {
      "type": "text",
      "id": "placeholder",
      "label": "入力欄の表示",
      "default": "メールアドレス"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "ボタンの文字",
      "default": "メールで受け取る"
    },
    {
      "type": "text",
      "id": "success_message",
      "label": "登録完了のメッセージ",
      "default": "ご登録ありがとうございます。次回の配信（毎月1日）で限定壁紙をお届けします。"
    },
    {
      "type": "header",
      "content": "受け取り方法"
    },
    {
      "type": "select",
      "id": "primary",
      "label": "優先する受け取り方法",
      "default": "line",
      "options": [
        {
          "value": "line_only",
          "label": "LINE公式アカウントのみ（メール欄を表示しない）"
        },
        {
          "value": "line",
          "label": "LINE公式アカウント（LINEを先に大きく表示）"
        },
        {
          "value": "email",
          "label": "メールマガジン（メールを先に表示）"
        }
      ],
      "info": "LINE のリンクが未設定の場合はメールのみ表示します。"
    },
    {
      "type": "text",
      "id": "or_label",
      "label": "区切りの文字",
      "default": "または"
    },
    {
      "type": "text",
      "id": "email_lead",
      "label": "メール欄の上の補足（LINE優先のとき）",
      "default": "LINEを使っていない方はメールで受け取れます"
    },
    {
      "type": "header",
      "content": "LINE公式アカウント"
    },
    {
      "type": "url",
      "id": "line_url",
      "label": "LINE 友だち追加のリンク",
      "info": "例：https://lin.ee/xxxx 。空欄の場合は LINE ボタンを表示しません。"
    },
    {
      "type": "text",
      "id": "line_label",
      "label": "LINE ボタンの文字",
      "default": "LINEで友だち追加して受け取る"
    },
    {
      "type": "text",
      "id": "line_caption",
      "label": "LINE ボタンの下の補足",
      "default": "友だち追加するだけで、毎月1日に届きます"
    },
    {
      "type": "image_picker",
      "id": "qr_image",
      "label": "友だち追加の QR コード（PC のみ表示）",
      "info": "LINE Official Account Manager の「友だち追加ガイド」からダウンロードできます。スマホでは表示しません。"
    },
    {
      "type": "text",
      "id": "qr_label",
      "label": "QR コードの下の文字",
      "default": "スマホで読み取って追加"
    },
    {
      "type": "richtext",
      "id": "note",
      "label": "注記",
      "default": "<p>ご登録いただいたメールアドレスは、<a href=\"/policies/privacy-policy\" title=\"プライバシーポリシー\">プライバシーポリシー</a>に基づいて管理します。配信はいつでも停止できます。</p>"
    },
    {
      "type": "text",
      "id": "tag",
      "label": "顧客に付けるタグ",
      "default": "newsletter",
      "info": "顧客一覧でメルマガ登録者を絞り込むときに使えます。"
    }
  ],
  "blocks": [
    {
      "type": "perk",
      "name": "特典",
      "settings": [
        {
          "type": "paragraph",
          "content": "特典を追加すると、左の見本画像の代わりに特典を横に並べて表示します。"
        },
        {
          "type": "select",
          "id": "style",
          "label": "見本画像の見せ方",
          "default": "phone",
          "options": [
            { "value": "phone", "label": "スマホの画面風（壁紙など）" },
            { "value": "icon", "label": "丸いアイコン（アイコン画像など・最大3つ並べる）" },
            { "value": "plain", "label": "角丸の画像のみ" }
          ]
        },
        { "type": "image_picker", "id": "image", "label": "見本画像" },
        { "type": "image_picker", "id": "image_2", "label": "見本画像 2（丸いアイコンのみ）" },
        { "type": "image_picker", "id": "image_3", "label": "見本画像 3（丸いアイコンのみ）" },
        { "type": "checkbox", "id": "watermark", "label": "「SAMPLE」の透かしを入れる（丸いアイコン以外）", "default": false },
        { "type": "text", "id": "label", "label": "ラベル（受け取り方など）", "default": "毎月1日に配信" },
        { "type": "text", "id": "title", "label": "特典の名前", "default": "限定壁紙" },
        { "type": "text", "id": "text", "label": "説明" }
      ]
    }
  ],
  "max_blocks": 4,
  "presets": [
    {
      "name": "メルマガ・LINE登録"
    }
  ]
}
{% endschema %}
