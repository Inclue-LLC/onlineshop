{%- liquid
  assign source = section.settings.collection
  assign more_url = section.settings.more_url | default: source.url | default: routes.all_products_collection_url
-%}
<section class="b-section b-product-showcase color-{{ section.settings.color_scheme }} gradient">
  <div class="b-container">
    {%- render 'b-section-head',
      heading: section.settings.heading,
      subheading: section.settings.subheading,
      link_label: section.settings.more_label,
      link_url: more_url
    -%}
    <div class="b-grid b-grid--4 b-grid--sp-2">
      {%- if source != blank and source.products_count > 0 -%}
        {%- for product in source.products limit: section.settings.limit -%}
          {%- render 'b-product-card',
            product: product,
            index: forloop.index0,
            new_tag: section.settings.new_tag,
            tax_label: section.settings.tax_label
          -%}
        {%- endfor -%}
      {%- else -%}
        {%- for i in (1..4) -%}
          {%- render 'b-product-card', product: blank, index: forloop.index0, tax_label: section.settings.tax_label -%}
        {%- endfor -%}
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "オンラインショップ",
  "tag": "div",
  "settings": [
    { "type": "text", "id": "heading", "label": "見出し", "default": "オンラインショップ" },
    { "type": "text", "id": "subheading", "label": "小見出し", "default": "新着・おすすめアイテム" },
    { "type": "collection", "id": "collection", "label": "表示するコレクション", "info": "例：新着・おすすめ をまとめたコレクション" },
    { "type": "range", "id": "limit", "label": "表示件数", "min": 2, "max": 12, "step": 1, "default": 4 },
    { "type": "text", "id": "new_tag", "label": "NEW バッジを付けるタグ", "default": "NEW" },
    { "type": "text", "id": "tax_label", "label": "価格の後ろの表記", "default": "（税込）" },
    { "type": "text", "id": "more_label", "label": "右上リンクの文字", "default": "すべての商品を見る" },
    { "type": "url", "id": "more_url", "label": "右上リンクのリンク先", "info": "未設定の場合はコレクションのページ" },
    { "type": "color_scheme", "id": "color_scheme", "label": "配色", "default": "scheme-2" }
  ],
  "presets": [{ "name": "オンラインショップ" }]
}
{% endschema %}
